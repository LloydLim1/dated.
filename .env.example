# Local pilot. Set a durable path on a single persistent Node server.
DATED_DATA_DIR=.data
# Set this to the exact HTTPS origin when hosting behind a proxy.
DATED_ORIGIN=
# Never use this filesystem-backed pilot on ephemeral/serverless hosting.
# MapLibre defaults to OpenFreeMap Positron with Dated's sage/forest palette (no API key).
# Optional alternative map style; keep the provider's attribution requirements.
NEXT_PUBLIC_MAP_STYLE_URL=
# Optional dedicated/self-hosted Overpass endpoint for live place discovery.
# Default: public overpass-api.de (pilot use, cached and limited to 100 searches/day).
DATED_OVERPASS_URL=
# Refresh the imported Metro Manila directory every seven days on a persistent server.
# Catches up after restart. Disable for tests or when an external scheduler runs places:sync.
DATED_AUTO_REFRESH=true
